TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_ALLOW_ALL_CHATS=false
TELEGRAM_ADAPTER_STATE=.adapter_state/telegram_polling_state.json
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_POLL_INTERVAL=2
TELEGRAM_SOURCE_ID=telegram:primary
TELEGRAM_SOURCE_NAME=Telegram Bot
TELEGRAM_HEALTH_REPORT_INTERVAL=300
TELEGRAM_MAX_RETRY_INTERVAL=300
TASK_TRACKER_URL=http://127.0.0.1:8000
TASK_TRACKER_API_KEY=change-me
# Outbound notifications (digest, reminders, review-request buttons) — used by
# automation/, same bot. Unset = notifications off.
TELEGRAM_NOTIFY_CHAT_ID=
# TELEGRAM_DIGEST_VOICE=1
# TELEGRAM_DIGEST_VOICE_NAME=Samantha

# Telegram Business ingestion (opt-in): the bot, connected to your personal
# Telegram account via Settings -> Telegram Business -> Chatbots, read-only
# collects task candidates from your private chats and sends approve/skip
# cards to TELEGRAM_NOTIFY_CHAT_ID. Requires Telegram Premium and Business
# Mode enabled for the bot in @BotFather. See adapters/README.md.
# TELEGRAM_BUSINESS_TASKS=1
# TELEGRAM_BUSINESS_STATE=.adapter_state/telegram_business_state.json
# BUSINESS_ANALYZE_MODEL=
# BUSINESS_ANALYZE_LULL=180
# BUSINESS_ANALYZE_MAX_WAIT=900
# BUSINESS_MIN_CONFIDENCE=0.6
# BUSINESS_VOICE_MAX_SECONDS=300
# BUSINESS_IGNORE_CHAT_IDS=
