DATABASE_URL=sqlite:///./task_tracker.db
TASK_TRACKER_API_KEY=change-me
APP_NAME=Personal Task Assistant
PUBLIC_BASE_URL=http://127.0.0.1:8000
TASK_STORE=sqlite
SESSION_SECRET_KEY=change-this-long-random-string
SESSION_COOKIE_HTTPS=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=you@example.com
TASK_HISTORY_SHEET_ID=
TASK_HISTORY_SHEET_TAB=Task History

# --- Daily agent ritual (automation/, docker-compose `ritual` service) ---
# When to run the daily check, HH:MM local time (docker-compose only; for
# launchd/systemd the time lives in the job definition).
RITUAL_TIME=15:00
# Set to 1 to let the agent work the codex queue (claim -> finish to review).
# Without it the ritual still writes the daily digest.
DAILY_RITUAL_WORK=
# Required only when DAILY_RITUAL_WORK=1.
ANTHROPIC_API_KEY=
DAILY_RITUAL_MODEL=claude-opus-4-8
