<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job that keeps the watch loop (reminders, review requests, agent
  trigger) running. __REPO__ is replaced with the absolute repository path by
  install.sh. Do not load this directly; run automation/install.sh --watch.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taskassistant.watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/automation/watch_run.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__REPO__/automation/logs/watch.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/automation/logs/watch.err.log</string>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>
</dict>
</plist>
